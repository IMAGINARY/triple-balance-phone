:: End2 [ending prose] {"position":"25,1550","size":"100,100"}
ui.status: true
ui.headerRight: "{translated link: \"common.restart\", to: '[[Restart->Start]]'}"
ui.footerCenter: ""
--
{translate text: "end.end2.text1"}
{summary row: "circularity", value: circle, first: true}
[if circle < 4]
{translate rich text: "end.end2.circularity.minimal"}
[if circle > 3 && circle < 5]
{translate rich text: "end.end2.circularity.limited"}
[if circle > 4 && circle < 8]
{translate rich text: "end.end2.circularity.improved"}
[if circle > 7 && circle < 11]
{translate rich text: "end.end2.circularity.significant"}
[if circle > 10]
{translate rich text: "end.end2.circularity.tremendous"}
[continue]
{end summary row}

{summary row: "happiness", value: happy}
[if happy < 3]
{translate rich text: "end.end2.happiness.low"}

[if happy > 2 && happy < 7]
{translate rich text: "end.end2.happiness.stable"}

[if happy > 6 && happy < 10]
{translate rich text: "end.end2.happiness.high"}

[if happy > 9]
{translate rich text: "end.end2.happiness.veryHigh"}
[continue]
{end summary row}

{summary row: "budget", value: money}
[if money < 2]
{translate text: "end.end2.budget.nearBankruptcy"}

[if money > 1 && money < 5]
{translate rich text: "end.end2.budget.decreased"}

[if money > 4 && money < 6]
{translate rich text: "end.end2.budget.unchanged"}

[if money > 5]
{translate rich text: "end.end2.budget.increased"}
[continue]
{end summary row}


[if happy > 0]
<div class="passage-navigation">
{translated link: "common.continue", to: '[[Continue->End3]]', role: "continue"}
</div>


:: End3 [ending] {"position":"475,1275","size":"100,100"}
ui.footerRight: "{translated link: \"common.credits\", to: '[[Credits->End.Credits]]'}"
ui.status: true
ui.footerCenter: ""
--
<div class="ending-assessment">
[if score <= window.TripleBalanceScores.minimumScore(100)]
{translate text: "end.end3.scoreText", score: score, percentile: Math.floor(window.TripleBalanceScores.percentile(score))} <br><br>

[if score > window.TripleBalanceScores.minimumScore(100)]
<img src="images/corruption.webp" class="score-corrupt"> <br>
{translate rich text: "end.end3.corruption.text1"}

[if score == window.TripleBalanceScores.minimumScore(100)]
<img src="images/very-good.png" class="score-icon"> <img src="images/very-good.png" class="score-icon"> <img src="images/very-good.png" class="score-icon"> <br>
{translate rich text: "end.end3.highScore.text1"}

[if score >= window.TripleBalanceScores.minimumScore(90) && score < window.TripleBalanceScores.minimumScore(100)]
<img src="images/very-good.png" class="score-icon"> <br>
{translate rich text: "end.end3.outstanding.text1"} 

[if score >= window.TripleBalanceScores.minimumScore(60) && score < window.TripleBalanceScores.minimumScore(90)]
<img src="images/good.png" class="score-icon"> <br>
{translate text: "end.end3.good.text1"} 

[if score >= window.TripleBalanceScores.minimumScore(40) && score < window.TripleBalanceScores.minimumScore(60)]
<img src="images/neutral.png" class="score-icon"> <br>
{translate text: "end.end3.average.text1"} 

[if score >= window.TripleBalanceScores.minimumScore(20) && score < window.TripleBalanceScores.minimumScore(40)]
<img src="images/bad.png" class="score-icon"> <br>
{translate text: "end.end3.poor.text1"} 

[if score >= window.TripleBalanceScores.minimumScore(0) && score < window.TripleBalanceScores.minimumScore(20)]
<img src="images/bad.png" class="score-icon"> <br>
{translate text: "end.end3.barelySurvived.text1"}


[continue]
{translated link: "common.runAgain", to: '[[Run for office again->Start]]'}
</div>

<div class="score-details-link">
{translated link: "common.learnScore", to: '[[Learn more about the score->End4]]'}
</div>


