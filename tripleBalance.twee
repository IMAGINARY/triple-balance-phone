:: StoryScript [script]
/* Derived score (tb10). */
engine.extend('2.3.1', () => {
  // Lookup variables are calculated on every read, including after restart or
  // save restoration. Keep the formula here rather than in ending passages.
  engine.state.setLookup('score', get =>
    2.5 * (get('circle') ?? 0) + 1.5 * (get('happy') ?? 0) + (get('money') ?? 0)
  );
  // Only an End1 reached in this playthrough counts as successful. Reading
  // history avoids a saved completion flag surviving a restart or Game Over.
  engine.state.setLookup('gameSuccessful', get => {
    const trail = get('trail');
    if (!Array.isArray(trail)) return false;
    const lastResetOrFailure = Math.max(trail.lastIndexOf('Start'),
      trail.lastIndexOf('Game over'), trail.lastIndexOf('Game over2'));
    return trail.lastIndexOf('End1') > lastResetOrFailure
      && get('happy') > 0 && get('money') > 0;
  });
});

/* Score distribution lookup. */
engine.extend('2.3.1', () => {
  // Refresh with: python3 analysis/count_paths.py --update-story
  // BEGIN GENERATED SCORE DISTRIBUTION
  const distribution = {"population":"successful_paths","totalPaths":3597500,"scores":[7.5,8.5,9.0,9.5,10.0,10.5,11.0,11.5,12.0,12.5,13.0,13.5,14.0,14.5,15.0,15.5,16.0,16.5,17.0,17.5,18.0,18.5,19.0,19.5,20.0,20.5,21.0,21.5,22.0,22.5,23.0,23.5,24.0,24.5,25.0,25.5,26.0,26.5,27.0,27.5,28.0,28.5,29.0,29.5,30.0,30.5,31.0,31.5,32.0,32.5,33.0,33.5,34.0,34.5,35.0,35.5,36.0,36.5,37.0,37.5,38.0,38.5,39.0,39.5,40.0,40.5,41.0,41.5,42.0,42.5,43.0,43.5,44.0,44.5,45.0,45.5,46.0,46.5,47.0,47.5,48.0,48.5,49.0,49.5,50.0,50.5,51.0,51.5,52.0,53.0],"cumulativeCounts":[52,133,308,417,1253,1807,2932,5203,7352,12278,17772,24595,36020,47986,66143,87711,111765,144955,181295,225711,277634,334048,400603,473239,555068,642775,737180,840558,946580,1062250,1179932,1300137,1427523,1551300,1680743,1808730,1932446,2060679,2180093,2299124,2415658,2521704,2629183,2726741,2817958,2907371,2984299,3059204,3127656,3186413,3244054,3292624,3336116,3377092,3409735,3440330,3466935,3488140,3508388,3524326,3537657,3549952,3558924,3566966,3573664,3578474,3583027,3586332,3588825,3591147,3592646,3593906,3594936,3595564,3596159,3596552,3596808,3597055,3597184,3597291,3597374,3597407,3597448,3597468,3597477,3597490,3597493,3597497,3597499,3597500]};
  // END GENERATED SCORE DISTRIBUTION

  Object.freeze(distribution.scores);
  Object.freeze(distribution.cumulativeCounts);
  Object.freeze(distribution);

  function requireNumber(value) {
    if (typeof value !== 'number' || !Number.isFinite(value)) {
      throw new TypeError('Expected a finite number.');
    }
  }

  // Unrounded percentage of successful paths scoring at or below this score.
  // A display can use Math.floor(percentile(score)) without changing the lookup.
  function percentile(score) {
    requireNumber(score);
    let low = 0;
    let high = distribution.scores.length;
    while (low < high) {
      const middle = Math.floor((low + high) / 2);
      if (distribution.scores[middle] <= score) low = middle + 1;
      else high = middle;
    }
    return low === 0 ? 0
      : 100 * distribution.cumulativeCounts[low - 1] / distribution.totalPaths;
  }

  // Lowest attainable score reaching the requested cumulative percentage.
  // Percentile 0 is explicitly defined as the minimum successful score.
  function minimumScore(percentileValue) {
    requireNumber(percentileValue);
    if (percentileValue < 0 || percentileValue > 100) {
      throw new RangeError('Percentile must be between 0 and 100.');
    }
    let low = 0;
    let high = distribution.scores.length - 1;
    while (low < high) {
      const middle = Math.floor((low + high) / 2);
      if (100 * distribution.cumulativeCounts[middle] / distribution.totalPaths
          >= percentileValue) high = middle;
      else low = middle + 1;
    }
    return distribution.scores[low];
  }

  window.TripleBalanceScores = Object.freeze({ distribution, percentile, minimumScore });
});
/* End score distribution lookup. */

/* Optional end-condition override. Normal route links stay visible to Twine. */
engine.extend("2.3.1", () => {
  engine.template.inserts.add({
    match: /^game over override$/i,
    render: () => '<div hidden data-game-over-override></div>'
  });

  function overrideContinueDestination(event) {
    const article = event.target;
    if (!(article instanceof HTMLElement) || !article.matches("#page article")) return;
    const happiness = Number(engine.state.get("happy"));
    const budget = Number(engine.state.get("money"));
    const destination = happiness <= 0 ? "Game over" : budget <= 0 ? "Game over2" : null;
    const visited = new Set();
    article.querySelectorAll("[data-game-over-override]").forEach(marker => {
      const navigation = marker.closest(".passage-navigation");
      if (!navigation || visited.has(navigation)) return;
      visited.add(navigation);
      navigation.querySelectorAll('passage-link[data-navigation-role="continue"]').forEach(link => {
        // Retain the normal destination if the hook is invoked again on this body.
        if (!link.dataset.normalDestination) link.dataset.normalDestination = link.getAttribute("to");
        link.setAttribute("to", destination || link.dataset.normalDestination);
      });
    });
  }

  window.addEventListener("body-content-change", overrideContinueDestination);
});

/* Reusable effect-row presentation, adapted from tribalance3.twee. */
engine.extend('2.3.1', () => {
  const metricIcons = {
    circularity: 'images/circularity.webp',
    happiness: 'images/good.webp',
    budget: 'images/money.webp'
  };

  const trendIcons = {
    up: 'images/up.webp',
    down: 'images/down.webp',
    unchanged: 'images/nochange.webp'
  };

  const escapeHtml = value => String(value)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

  const metricImage = metric => {
    const source = metricIcons[metric];

    if (!source) {
      throw new Error(`Unknown metric in component: ${metric}`);
    }

    return `<img class="metric-icon" src="${source}" alt="">`;
  };

  function rowDescription(props) {
    if (props.textKey !== undefined && props.text !== undefined) {
      throw new Error('Use either textKey or text in a row, not both.');
    }
    if (props.textKey !== undefined) {
      if (typeof props.textKey !== 'string' || !props.textKey.trim()) {
        throw new Error('A row textKey must be a nonempty string.');
      }
      return window.ChapbookI18n.renderText(props.textKey);
    }
    return escapeHtml(props.text);
  }

  engine.template.inserts.add({
    match: /^effect row$/i,
    render(metric, props) {
      const trend = String(props.trend).toLowerCase();
      const trendSource = trendIcons[trend];

      if (!trendSource) {
        throw new Error(`Unknown trend in effect row: ${trend}`);
      }

      const description = rowDescription(props);

      const firstClass = props.first ? ' effect-row-first' : '';

      return `<div class="effect-row${firstClass}">
        <div class="effect-icons">
          ${metricImage(String(metric).toLowerCase())} :
          <img class="trend-icon" src="${trendSource}" alt="">
        </div>
        <div class="effect-text">${description}</div>
      </div>`;
    }
  });

  engine.template.inserts.add({
    match: /^status row$/i,
    render(metric, props) {
      const firstClass = props.first ? ' effect-row-first' : '';
      return `<div class="effect-row status-row${firstClass}">
        <div class="effect-icons">
          ${metricImage(String(metric).toLowerCase())} = ${escapeHtml(props.value)}
        </div>
        <div class="effect-text">${rowDescription(props)}</div>
      </div>`;
    }
  });

  // Paired inserts keep conditional explanations in the passage source.
  engine.template.inserts.add({
    match: /^summary row$/i,
    render(metric, props) {
      const firstClass = props.first ? ' effect-row-first' : '';
      return `<div class="summary-row${firstClass}">
        <div class="summary-icons">
          ${metricImage(String(metric).toLowerCase())} = ${escapeHtml(props.value)}
        </div>
        <div class="summary-text">`;
    }
  });

  engine.template.inserts.add({
    match: /^end summary row$/i,
    render: () => '</div></div>'
  });


  /* Resolve UI settings from this passage's vars section, never inherited state.
     Settings are JSON literals; strings can contain normal Twine links/inserts. */
  const uiModesByTag = {
    intro: 'intro', explanation: 'intro', round: 'round',
    policy: 'gameplay', event: 'gameplay', outcome: 'gameplay',
    technology: 'gameplay', ending: 'results'
  };

  function passageUiSettings(passage) {
    const separator = /^--\s*$/m.exec(passage.source);
    const vars = separator ? passage.source.slice(0, separator.index) : '';
    const settings = {};
    for (const line of vars.split('\n')) {
      const match = /^ui\.(mode|round|status|skip|headerRight|footerLeft|footerCenter|footerRight):\s*(.+)$/.exec(line);
      if (match) settings[match[1]] = JSON.parse(match[2]);
    }
    return settings;
  }

  function renderUiControls(source) {
    return source ? `<div class="ui-controls">${engine.template.render(source)}</div>` : '';
  }

  function uiMetric(metric, value) {
    return `<span class="ui-metric">${metricImage(metric)}<span>: ${escapeHtml(value)}</span></span>`;
  }

  function renderPassageUi(event) {
    const passage = engine.story.passageNamed(engine.state.get('passage.name'));
    if (!passage) return;
    const settings = passageUiSettings(passage);
    const tag = passage.tags.find(value => Object.hasOwn(uiModesByTag, value));
    const mode = settings.mode || uiModesByTag[tag] || 'gameplay';
    if (!['intro', 'gameplay', 'round', 'results', 'game-over'].includes(mode)) {
      throw new Error(`Unknown UI mode: ${mode}`);
    }
    const gameplay = mode === 'gameplay' || mode === 'round';
    const status = settings.status ?? gameplay;
    const skip = settings.skip ?? mode === 'intro';
    const footer = { left: '', center: '', right: '' };
    const header = {
      left: engine.template.render("{language selector}"),
      center: engine.template.render(`<div class="ui-identity"><img class="ui-logo" src="images/happy_phone.png" alt=""><span class="ui-title-group"><span class="header-title">{translate text: "header.title"}</span><br><span class="ui-subtitle">{translate text: "header.subtitle"}</span></span></div>`),
      right: renderUiControls(settings.headerRight ?? (gameplay ? `{translated link: "common.restart", to: '[[Restart->Start]]'}` : ''))
    };
    if (status) {
      footer.left = `<div class="ui-status">${uiMetric('happiness', engine.state.get('happy'))}${uiMetric('budget', engine.state.get('money'))}</div>`;
      footer.right = `<div class="ui-status">${uiMetric('circularity', engine.state.get('circle'))}</div>`;
    }
    if (skip) {
      footer.right = engine.template.render(`{translated link: "footer.skipExplanations", to: '[[Skip explanations->Start5]]'}`);
    }
    if (mode === 'round') {
      if (!Number.isInteger(settings.round) || settings.round < 1 || settings.round > 6) {
        throw new Error('Round UI requires ui.round between 1 and 6');
      }
      footer.center = window.ChapbookI18n.renderText("common.roundProgress", { round: settings.round, total: 6 });
    }
    if (mode === 'results' || mode === 'game-over') {
      footer.center = renderUiControls(`{translated link: "common.restart", to: '[[Restart->Start]]'} {translated link: "common.credits", to: '[[Credits->End.Credits]]'}`);
    }
    for (const slot of ['left', 'center', 'right']) {
      const key = `footer${slot[0].toUpperCase()}${slot.slice(1)}`;
      if (Object.hasOwn(settings, key)) footer[slot] = renderUiControls(settings[key]);
    }
    // Chapbook updates its slots after inserting the body. Commit the complete
    // layout once that render finishes, without changing config or game state.
    queueMicrotask(() => {
      const page = document.querySelector('#page');
      for (const [name, slots] of Object.entries({ header, footer })) {
        const element = page.querySelector(`:scope > ${name}`);
        element.innerHTML = ['left', 'center', 'right']
          .map(slot => `<div class="${slot}">${slots[slot]}</div>`).join('');
        element.toggleAttribute('hidden', !Object.values(slots).some(Boolean));
      }
      page.dataset.uiMode = mode;
    });
  }

  document.addEventListener('body-content-change', renderPassageUi);

});

/* Connect passage tags to layouts after Chapbook inserts the new body. */
engine.extend("2.3.1", () => {
  const types = ["intro", "explanation", "round", "policy", "event", "outcome", "ending", "technology"];

  function applyPassageLayout(event) {
    const article = event.target;
    if (!(article instanceof HTMLElement) || !article.matches("#page article")) return;
    const passage = engine.story.passageNamed(engine.state.get("passage.name"));
    const tags = passage?.tags || [];
    const type = types.find(value => tags.includes(value));
    types.forEach(value => article.classList.remove(`passage-${value}`));
    article.classList.toggle("passage-prose", tags.includes("prose"));
    if (type) article.classList.add(`passage-${type}`);
    article.dataset.passageType = type || "";
  }

  window.addEventListener("body-content-change", applyPassageLayout);
});

/* Chapbook i18next integration, adapted from twine-i18n-chapbook.js (tb13). */
engine.extend("2.3.1", () => {
  const languages = [
    { code: "en", label: "English" },
    { code: "de", label: "Deutsch" },
    { code: "fr", label: "Français" },
    { code: "nl", label: "Nederlands" },
  ];
  const texts = new Set();
  const selectors = new Set();
  let translator;
  let ready = false;
  let busy = true;
  let errorKey = "";
  let initialization;

  // Emergency English copies of common UI keys keep loading/retry usable
  // before dictionaries exist, including when downloading them fails.
  const bootstrapUi = {
  "common.languageLabel": "Language",
  "common.languageRetry": "Retry",
  "common.languageLoading": "Loading…",
  "common.translationLoadError": "Could not load translations. Check your connection and retry.",
  "common.languageLoadError": "Could not load this language. Your previous language is still active."
};

  function interfaceText(key) {
    return ready ? translator.t(key) : bootstrapUi[key];
  }

  function escapeAttribute(value) {
    return String(value).replace(/[&<>"']/g, character => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[character]);
  }

  function refresh() {
    texts.forEach(element => element.update());
    selectors.forEach(element => element.update());
    if (ready) document.documentElement.lang = translator.resolvedLanguage || translator.language;
  }

  function loadScript(url, globalName) {
    if (window[globalName]) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const script = document.createElement("script");
      script.src = url;
      script.onload = () => window[globalName]
        ? resolve()
        : reject(new Error(`Missing library: ${globalName}`));
      script.onerror = () => {
        script.remove();
        reject(new Error(`Could not load ${url}`));
      };
      document.head.appendChild(script);
    });
  }

  // Language preference is separate from Chapbook gameplay/save state.
  function savedLanguage() {
    try {
      const code = localStorage.getItem("language");
      return languages.some(language => language.code === code) ? code : "en";
    } catch {
      return "en";
    }
  }

  function rememberLanguage(code) {
    try {
      localStorage.setItem("language", code);
    } catch {
      // Switching still succeeds when browser storage is unavailable.
    }
  }

  function initialize() {
    if (initialization) return initialization;
    busy = true;
    errorKey = "";
    refresh();
    initialization = (async () => {
      try {
        await loadScript("https://cdn.jsdelivr.net/npm/i18next@25/dist/umd/i18next.min.js", "i18next");
        await loadScript("https://cdn.jsdelivr.net/npm/i18next-http-backend@4/i18nextHttpBackend.min.js", "i18nextHttpBackend");
        translator = await createTranslator(savedLanguage());
        ready = true;
      } catch (error) {
        errorKey = "common.translationLoadError";
        console.error("Chapbook i18n initialization failed:", error);
      } finally {
        busy = false;
        refresh();
      }
    })();
    return initialization;
  }

  async function createTranslator(language, resources) {
    const instance = window.i18next.createInstance();
    instance.use(window.i18nextHttpBackend);
    await new Promise((resolve, reject) => instance.init({
      lng: language,
      fallbackLng: "en",
      supportedLngs: languages.map(item => item.code),
      load: "languageOnly",
      keySeparator: ".",
      // Resolve nested dictionary sections; also accept legacy flat German keys.
      ignoreJSONStructure: true,
      // Reuse downloaded JSON, but isolate a failed attempt from the active instance.
      resources: resources ? JSON.parse(JSON.stringify(resources)) : undefined,
      partialBundledLanguages: true,
      interpolation: { escapeValue: false }, // Output is assigned via textContent.
      backend: { loadPath: "i18n/{{lng}}.json" },
    }, error => error ? reject(error) : resolve()));
    return instance;
  }

  async function changeLanguage(code) {
    if (!ready || busy) return;
    if (!languages.some(language => language.code === code)) {
      throw new Error(`Unsupported language: ${code}`);
    }
    busy = true;
    errorKey = "";
    refresh();
    try {
      // Commit only after loading succeeds. A fresh candidate also permits retrying
      // downloads that i18next's backend has previously marked as failed.
      translator = await createTranslator(code, translator.store.data);
      rememberLanguage(code);
    } catch (error) {
      errorKey = "common.languageLoadError";
      console.error("Chapbook language change failed:", error);
    } finally {
      busy = false;
      // Update only text nodes and controls. Never rerender a passage or change state.
      refresh();
    }
  }

  class TranslatedText extends HTMLElement {
    connectedCallback() {
      texts.add(this);
      this.update();
    }
    disconnectedCallback() { texts.delete(this); }
    update() {
      const key = this.getAttribute("key");
      const options = JSON.parse(this.getAttribute("options") || "{}");
      this.textContent = ready ? translator.t(key, options) : key;
    }
  }

  function inlineRichText(source) {
    const template = document.createElement("template");
    template.innerHTML = source;
    const fragment = document.createDocumentFragment();
    const allowedTags = new Set(["B", "STRONG", "SPAN"]);
    const allowedClasses = new Set(["policy", "tech", "event"]);
    const blockedTags = new Set(["SCRIPT", "STYLE", "IFRAME", "OBJECT", "EMBED", "SVG", "MATH", "TEMPLATE"]);
    function copy(node, parent) {
      if (node.nodeType === Node.TEXT_NODE) {
        parent.appendChild(document.createTextNode(node.textContent));
      } else if (node.nodeType === Node.ELEMENT_NODE && !blockedTags.has(node.tagName)) {
        let target = parent;
        if (allowedTags.has(node.tagName)) {
          target = document.createElement(node.tagName.toLowerCase());
          if (node.tagName === "SPAN") {
            const classes = Array.from(node.classList).filter(value => allowedClasses.has(value));
            if (classes.length) target.className = classes.join(" ");
          }
          parent.appendChild(target);
        }
        for (const child of node.childNodes) copy(child, target);
      }
    }
    for (const child of template.content.childNodes) copy(child, fragment);
    return fragment;
  }

  class TranslatedRichText extends TranslatedText {
    update() {
      const key = this.getAttribute("key");
      const options = JSON.parse(this.getAttribute("options") || "{}");
      // Interpolated values remain literal text, even within a rich translation.
      const value = ready ? translator.t(key, {
        ...options, interpolation: { ...options.interpolation, escapeValue: true }
      }) : key;
      this.replaceChildren(inlineRichText(value));
    }
  }

  // The generated SVG supplies static geometry; this component adds the score
  // marker and translates text without rerendering passages or changing state.
  let scoreChartTemplate;
  let scoreChartSequence = 0;
  function loadScoreChart() {
    if (!scoreChartTemplate) {
      scoreChartTemplate = fetch('images/score-histogram.svg')
        .then(response => {
          if (!response.ok) throw new Error('Could not load the score histogram.');
          return response.text();
        })
        .then(source => {
          const document = new DOMParser().parseFromString(source, 'image/svg+xml');
          if (document.querySelector('parsererror') || document.documentElement.localName !== 'svg') {
            throw new Error('Invalid score histogram SVG.');
          }
          return document.documentElement;
        })
        .catch(error => { scoreChartTemplate = undefined; throw error; });
    }
    return scoreChartTemplate;
  }

  class ScoreHistogram extends HTMLElement {
    connectedCallback() {
      texts.add(this);
      this.tabIndex = 0; // Allows keyboard scrolling on narrow screens.
      this.resizeObserver ??= new ResizeObserver(() => this.centerMarker());
      this.resizeObserver.observe(this);
      if (!this.svg && !this.loading) {
        this.loading = true;
        this.failed = false;
        loadScoreChart().then(template => {
          this.svg = document.importNode(template, true);
          
// Reposition the "Final score" X-axis label
const scoreAxis = this.svg.querySelector('[data-chart-text="scoreAxis"]');

if (scoreAxis) {
  scoreAxis.setAttribute('transform', 'translate(400, -120)');
}         

// Remove the visible chart title
this.svg.querySelector('text[data-chart-text="title"]')?.remove();

// Crop top and bottom to save vertical space
const { x, y, width, height } = this.svg.viewBox.baseVal;

const cropTop = 30;
const cropBottom = 40;

this.svg.setAttribute(
  'viewBox',
  `${x} ${y + cropTop} ${width} ${height - cropTop - cropBottom}`
);

this.svg.setAttribute('height', height - cropTop - cropBottom);

          const id = `score-chart-${++scoreChartSequence}`;
          this.svg.querySelector('title').id = `${id}-title`;
          this.svg.querySelector('desc').id = `${id}-description`;
          this.svg.setAttribute('aria-labelledby', `${id}-title ${id}-description`);
          this.replaceChildren(this.svg);
          this.loading = false;
          this.drawMarker();
          this.update();
        }).catch(error => {
          this.loading = false;
          this.failed = true;
          console.error('Score histogram failed:', error);
          this.update();
        });
      }
      this.update();
    }
    disconnectedCallback() {
      texts.delete(this);
      this.resizeObserver.disconnect();
    }

    drawMarker() {
      if (this.getAttribute('successful') !== 'true') return;
      const score = Number(this.getAttribute('score'));
      const bars = [...this.svg.querySelectorAll('rect[data-score]')];
      const first = bars[0];
      const last = bars[bars.length - 1];
      const step = Number(first.getAttribute('width'));
      const left = Number(first.getAttribute('x')) + step / 2;
      const right = Number(last.getAttribute('x')) + step / 2;
      const baseline = Number(first.getAttribute('y')) + Number(first.getAttribute('height'));
      const x = Math.max(left, Math.min(right,
        left + (score - Number(first.dataset.score)) / 0.5 * step));
      this.markerX = x;
      this.bin = bars.find(bar => Number(bar.dataset.score) === score);
      if (this.bin) {
        this.bin.setAttribute('fill', '#efb477');
        this.bin.setAttribute('stroke', '#803b13');
        this.bin.setAttribute('stroke-width', '1');
        this.bin.setAttribute('data-current-score', '');
      }
      const marker = this.svg.querySelector('[data-score-marker]');
      const add = (tag, attrs) => {
        const node = document.createElementNS('http://www.w3.org/2000/svg', tag);
        Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
        marker.append(node);
        return node;
      };
      add('line', { x1: x, x2: x, y1: this.bin?.getAttribute('y') ?? baseline,
        y2: baseline, stroke: '#803b13', 'stroke-width': 2, 'data-score-line': '' });
      add('path', { d: `M${x - 6} ${baseline + 10} L${x} ${baseline + 2} L${x + 6} ${baseline + 10} M${x} ${baseline + 2} V${baseline + 37}`,
        fill: 'none', stroke: '#803b13', 'stroke-width': 2, 'data-score-arrow': '' });
      add('text', { x, y: baseline + 60, 'text-anchor': x > right - 35 ? 'end' : x < left + 35 ? 'start' : 'middle',
        fill: '#803b13', 'font-size': 22, 'font-weight': 'bold', 'data-chart-text': 'you' });
      // Do not let an arrow drawn on a tick obscure the tick's number.
      this.svg.querySelectorAll('[data-score-tick]').forEach(tick => {
        if (Math.abs(Number(tick.getAttribute('x')) - x) < 15) tick.style.visibility = 'hidden';
      });
      this.centerMarker();
    }

    centerMarker() {
      if (this.svg && this.markerX !== undefined && this.scrollWidth > this.clientWidth) {
        this.scrollLeft = this.markerX * this.svg.getBoundingClientRect().width / 1060 - this.clientWidth / 2;
      }
    }

    update() {
      if (!this.svg) {
        this.textContent = ready
          ? translator.t(`end.end6.chart.${this.failed ? 'loadError' : 'loading'}`)
          : interfaceText('common.languageLoading');
        return;
      }
      const language = ready ? translator.resolvedLanguage || translator.language : 'en';
      const format = new Intl.NumberFormat(language);
      const score = Number(this.getAttribute('score'));
      const options = {
        score: format.format(score),
        percentile: Math.floor(window.TripleBalanceScores.percentile(score)),
        total: format.format(window.TripleBalanceScores.distribution.totalPaths),
        paths: format.format(Number(this.bin?.dataset.paths ?? 0))
      };
      this.svg.setAttribute('lang', language);
      this.svg.querySelectorAll('[data-chart-text]').forEach(node => {
        if (!ready) return;
        const bin = node.closest('rect[data-score]');
        const values = bin ? { score: format.format(Number(bin.dataset.score)), paths: format.format(Number(bin.dataset.paths)) } : options;
        const key = node.dataset.chartText === 'description' && this.getAttribute('successful') !== 'true'
          ? 'descriptionWithoutScore' : node.dataset.chartText;
        node.textContent = translator.t(`end.end6.chart.${key}`, values);
      });
      this.svg.querySelectorAll('[data-chart-number]').forEach(node => {
        node.textContent = format.format(Number(node.dataset.chartNumber));
      });
      if (ready) this.setAttribute('aria-label', translator.t('end.end6.chart.title'));
    }
  }
  customElements.define('chapbook-score-histogram', ScoreHistogram);
  engine.template.inserts.add({
    match: /^score histogram$/i,
    render(score, { successful = false } = {}) {
      if (typeof score !== 'number' || !Number.isFinite(score)) {
        throw new TypeError('The score histogram requires a finite score.');
      }
      if (typeof successful !== 'boolean') {
        throw new TypeError('Histogram success must be a boolean.');
      }
      return `<chapbook-score-histogram score="${escapeAttribute(score)}" successful="${successful}"></chapbook-score-histogram>`;
    }
  });

  class LanguageSelector extends HTMLElement {
    connectedCallback() {
      if (!this.select) {
        const label = document.createElement("label");
        this.labelText = document.createTextNode("");
        label.appendChild(this.labelText);
        this.select = document.createElement("select");
        languages.forEach(language => {
          const option = document.createElement("option");
          option.value = language.code;
          option.textContent = language.label;
          this.select.appendChild(option);
        });
        this.select.addEventListener("change", () => changeLanguage(this.select.value));
        label.appendChild(this.select);
        this.status = document.createElement("span");
        this.status.setAttribute("role", "status");
        this.retry = document.createElement("button");
        this.retry.type = "button";
        this.retry.addEventListener("click", () => {
          initialization = undefined;
          initialize();
        });
        this.append(label, this.status, this.retry);
      }
      selectors.add(this);
      this.update();
    }
    disconnectedCallback() { selectors.delete(this); }
    update() {
      this.select.disabled = busy || !ready;
      this.select.value = ready ? translator.resolvedLanguage || translator.language : "en";
      this.labelText.textContent = interfaceText("common.languageLabel") + " ";
      this.retry.textContent = interfaceText("common.languageRetry");
      this.status.textContent = busy ? " " + interfaceText("common.languageLoading")
        : errorKey ? " " + interfaceText(errorKey) : "";
      this.retry.hidden = ready || busy || !errorKey;
    }
  }

  customElements.define("chapbook-translated-text", TranslatedText);
  customElements.define("chapbook-translated-rich-text", TranslatedRichText);
  customElements.define("chapbook-language-selector", LanguageSelector);

  function translatedText(key, options = {}, rich = false) {
    if (typeof key !== "string" || !key) throw new Error("Translation key required");
    const tag = rich ? "chapbook-translated-rich-text" : "chapbook-translated-text";
    return `<${tag} key="${escapeAttribute(key)}" options="${escapeAttribute(JSON.stringify(options))}"></${tag}>`;
  }

  engine.template.inserts.add({
    match: /^translate\s+text$/i,
    render: (key, options) => translatedText(key, options),
  });
  engine.template.inserts.add({
    match: /^translate\s+rich\s+text$/i,
    render: (key, options) => translatedText(key, options, true),
  });
  engine.template.inserts.add({
    match: /^language\s+selector$/i,
    render: () => "<chapbook-language-selector></chapbook-language-selector>",
  });
  engine.template.inserts.add({
    match: /^translated\s+link$/i,
    render(key, { to, role, ...options }) {
      // Standard link notation inside a quoted argument keeps Twine map arrows.
      // Chapbook expands [[links]] before evaluating custom insert arguments.
      // Single quotes around the argument preserve the generated double-quoted HTML.
      const template = document.createElement("template");
      template.innerHTML = typeof to === "string" ? to : "";
      const link = template.content.firstElementChild;
      if (link?.tagName !== "PASSAGE-LINK" || template.content.childNodes.length !== 1) {
        throw new Error("Use to: '[[editor-label|Passage]]'");
      }
      const passage = link.getAttribute("to");
      if (!engine.story.passageNamed(passage)) throw new Error(`Unknown passage: ${passage}`);
      if (role !== undefined && (typeof role !== "string" || !role.trim())) {
        throw new Error("A navigation role must be a nonempty string.");
      }
      const roleAttribute = role ? ` data-navigation-role="${escapeAttribute(role)}"` : "";
      return `<passage-link class="link" to="${escapeAttribute(passage)}"${roleAttribute}>${translatedText(key, options)}</passage-link>`;
    },
  });

  // Useful for diagnostics; language is deliberately kept outside story state.
  window.ChapbookI18n = { languages, changeLanguage, renderText: translatedText, ready: initialize() };
});

:: StoryStylesheet [stylesheet]
html, body, #page, #passages {
    font-family: Helvetica, Arial, sans-serif !important;
}

#page footer {
    padding-bottom: 50px;
}

#page header {
    padding-top: 10px;
    padding-bottom: 0px !important;
}

.policy {
  background-color: cyan !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.tech {
  background-color: yellow !important;
  padding: 2px 6px;
  border-radius: 4px;
}

.event {
  background-color: magenta !important;
  padding: 2px 6px;
  border-radius: 4px;
}

/* FORCE BLACK LINK TEXT */
#page .policy,
#page .policy *,
#page .event,
#page .event *,
#page .tech,
#page .tech * {
  color: black !important;
}


.policy *:hover,
.event *:hover,
.tech *:hover {
  background-color: white !important;
  color: black !important;
}

/* Shared presentation classes (tb1). */
#page .effect-icons,
#page .summary-icons {
  white-space: nowrap;
}

#page .effect-text,
#page .summary-text {
  width: 100%;
}

#page .summary-text {
  line-height: 1;
}

#page .effect-row,
#page .summary-row {
  display: grid;
  grid-template-columns: 60px 1fr;
  column-gap: 20px;
  width: 100%;
  margin-bottom: 10px;
  align-items: start;
}

#page .summary-row {
  grid-template-columns: 80px 1fr;
  margin-bottom: 0;
  align-items: center;
}

#page .effect-row-first {
  margin-top: 12px;
}

#page .indicator-icon,
#page .metric-icon,
#page .trend-icon {
  height: 25px;
  position: relative;
  top: 5px;
}

/* Footer happiness and money icons */
#page footer .left .metric-icon {
  top: 3px;
}

/* Footer circularity icon */
#page footer .right .metric-icon {
  top: 5px;
}

#page .indicator-icon-offset-3 {
  top: 3px;
}

#page .score-icon {
  height: 50px;
  position: relative;
  top: 3px;
  right: 5px;
}

#page .score-corrupt {
  height: 150px;
  position: relative;
  top: 3px;
  right: 5px;
}

#page .balance-illustration {
  height: 103px;
  position: relative;
  top: 5px;
  left: 0;
}

#page .story-illustration {
  height: 150px;
  position: relative;
  top: 5px;
  left: 10px;
}


/* Tag-driven passage layouts (tb3).
   Passage tags select these article classes through StoryScript.
   Add the prose tag when a passage needs left-aligned reading text. */
#page article.passage-intro,
#page article.passage-event,
#page article.passage-ending,
#page article.passage-technology {
  text-align: center;
}

#page article.passage-explanation,
#page article.passage-round,
#page article.passage-policy,
#page article.passage-outcome,
#page article.passage-prose {
  text-align: left;
}

#page article .passage-title,
#page article .passage-navigation {
  text-align: center;
}

/* Indicator descriptions stay readable inside centered passage types. */
#page article .effect-row,
#page article .summary-row {
  text-align: left;
}


/* Title typography and ending details (tb5). */
#page article .passage-title,
#page article .game-over-label {
  font-weight: bold;
}

#page header .header-title {
  font-size: 20px;
  font-weight: bold;
}

#page article .ending-assessment {
  text-align: center;
}

#page article .score-details-link {
  font-size: 15px;
  text-align: right;
}

/* Shared header/footer interface (tb8). */
#page .ui-identity {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

#page .ui-logo {
  height: 50px;
}

#page .ui-title-group {
  display: inline-block;
  line-height: 0.9;
}

#page .ui-subtitle {
  font-size: 12px;
}

#page .ui-status,
#page .ui-metric,
#page .ui-controls,
#page .ui-controls > p {
  display: flex;
  align-items: center;
  gap: 8px;
}

#page .ui-status {
  flex-wrap: wrap;
  gap: 20px;
}

#page .ui-metric {
  white-space: nowrap;
}

#page .ui-controls,
#page .ui-controls > p {
  flex-wrap: wrap;
  justify-content: center;
  gap: 16px;
  margin: 0;
}

#page header .right .ui-controls,
#page footer .right .ui-controls,
#page footer .right .ui-controls > p,
#page footer .right .ui-status {
  justify-content: flex-end;
}


/* Passage illustrations and remaining body layout (tb9). */
#page .welcome-illustration {
  left: auto;
  right: 1px;
}

#page .research-result-illustration {
  left: auto;
  right: 10px;
}

#page .research-illustration,
#page .policy-illustration {
  position: relative;
  top: 5px;
}

#page .research-illustration {
  height: 117px;
}

#page .policy-illustration {
  height: 110px;
  left: 10px;
}

#page article.passage-ending {
  min-width: 0;
}

#page chapbook-score-histogram {
  display: block;
  width: 100%;
  max-width: 1060px;
  overflow-x: auto;
}

#page chapbook-score-histogram svg {
  display: block;
  width: 100%;
  min-width: 0;
  height: auto;
}

@media (max-width: 600px) {
  #page chapbook-score-histogram svg {
    min-width: 680px;
  }
}

#page .explanation-icon,
#page .explanation-link-icon {
  position: relative;
  top: 5px;
}

#page .explanation-icon {
  height: 50px;
}

#page .explanation-link-icon {
  height: 25px;
  right: 15px;
}

#page .explanation-happiness-link-icon {
  right: 12px;
  margin-right: 10px;
}

#page .game-over-heading-icon,
#page .game-over-icon,
#page .game-over-budget-icon {
  height: 50px;
  position: relative;
  top: 20px;
}

#page .game-over-heading-icon {
  top: 10px;
}

#page .game-over-budget-icon {
  height: 70px;
}

#page .credits-funding {
  font-size: 12px;
  line-height: 1.5;
  margin: 0;
  position: relative;
  top: -5px;
}

#page .illustration-group,
#page .research-choice {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 24px;
  max-width: 100%;
}

#page .research-choice {
  gap: 16px;
}